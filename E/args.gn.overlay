# Vanadium-E build argument overrides. Applied on top of ../args.gn by
# E/tools/build-args.sh. Any key listed here replaces the Vanadium value.

# Distinct package names so Vanadium-E installs alongside Vanadium.
chrome_public_manifest_package = "app.vanadiume.browser"
system_webview_package_name = "app.vanadiume.webview"
trichrome_library_package = "app.vanadiume.trichromelibrary"
config_apk_package = "app.vanadiume.config"

# MUST be replaced with the SHA-256 digest of YOUR signing certificate
# (keytool -list -v -keystore vanadium-e.keystore). The Vanadium digests in
# ../args.gn belong to the GrapheneOS key and will not match your builds.
trichrome_certdigest = "7cea22b2ec11681f5c39eac8e0cc79a58457a4dfd97a4703d96b7ce051536101"
config_apk_certdigest = "7cea22b2ec11681f5c39eac8e0cc79a58457a4dfd97a4703d96b7ce051536101"
